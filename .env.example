# Upscayl NCNN — build configuration
# Copy to .env and uncomment/modify as needed.
# Syntax: GNU Make format — KEY=value (no 'export', no quotes for simple values)

# Build settings
# BUILD_DIR=build
# BUILD_TYPE=Release
# PARALLEL_JOBS=4

# Compiler overrides (Linux defaults to gcc-9/g++-9 if available)
# CC=gcc-12
# CXX=g++-12

# Vulkan SDK path (run `make install-vulkan-sdk` or set manually)
# Linux:  VULKAN_SDK=/home/user/vulkan-sdk/1.3.280.0/x86_64
# macOS:  VULKAN_SDK=/Users/user/vulkan-sdk
# VULKAN_SDK=

# Vulkan SDK version (used by `make install-vulkan-sdk`)
# VK_VERSION=1.4.328.0

# macOS: OpenMP prefix (default: auto-detected via `brew --prefix libomp`)
# LIBOMP_PREFIX=/opt/homebrew/opt/libomp

# Extra CMake flags (appended after all generated flags)
# CMAKE_EXTRA_FLAGS=-DFOO=BAR
