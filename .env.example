# Upscayl NCNN — build configuration
# Copy to .env and uncomment/modify as needed.
# Syntax: GNU Make format — KEY=value (no 'export', no quotes for simple values)

# CMake preset (see CMakePresets.json for full list)
# PRESET=release

# Build settings
# BUILD_DIR=build
# PARALLEL_JOBS=4

# Compiler overrides (Linux defaults to gcc-9/g++-9 if available)
# Exported as env vars for CMake's compiler detection.
# CC=gcc-12
# CXX=g++-12

# Vulkan SDK path (auto-detected from vulkan-sdk/ after `make check`; override here)
# Exported as env var for CMake's FindVulkan and macOS MoltenVK paths.
# VULKAN_SDK=

# Vulkan SDK version (used by `make install-vulkan-sdk`)
# VK_VERSION=1.4.341.1

# Use system Vulkan packages instead of downloading the Lunarg SDK
# USE_SYSTEM_VULKAN=1

# macOS: OpenMP prefix (default: auto-detected via `brew --prefix libomp`)
# Exported as env var for CMakeLists.txt macOS OpenMP hints.
# LIBOMP_PREFIX=/opt/homebrew/opt/libomp
